<Window x:Class="TRIO2026.Simulator.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRIO2026 Hardware Simulator" Width="480" Height="640"
        Background="#1A1A2E" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 共用按鈕樣式 -->
        <Style x:Key="SimButton" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="16,8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔧 TRIO2026 Hardware Simulator"
                       FontSize="20" FontWeight="Bold" Foreground="#E0E0E0" />
            <TextBlock Text="TCP Server — 127.0.0.1:5020"
                       FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 連線狀態 -->
        <Border Grid.Row="1" Background="#16213E" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="12" Height="12"
                         Fill="#E74C3C" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           Text="等待連線..." FontSize="14" Foreground="#BDC3C7"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ClientCountText" Grid.Column="2"
                           Text="0 clients" FontSize="12" Foreground="#7F8C8D"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 門板控制 -->
        <Border Grid.Row="2" Background="#16213E" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🚪 門板控制" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E0E0E0" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnDoorOpen" Grid.Column="0"
                            Content="🔓 開啟門板" Style="{StaticResource SimButton}"
                            Background="#E74C3C" BorderBrush="#C0392B"
                            Click="BtnDoorOpen_Click" />
                    <Button x:Name="BtnDoorClose" Grid.Column="2"
                            Content="🔒 關閉門板" Style="{StaticResource SimButton}"
                            Background="#27AE60" BorderBrush="#219A52"
                            IsEnabled="False"
                            Click="BtnDoorClose_Click" />
                </Grid>

                <Border x:Name="DoorStatusPanel" Background="#2C3E50" CornerRadius="6"
                        Padding="10,6" Margin="0,10,0,0">
                    <TextBlock x:Name="DoorStatusText" Text="門板狀態：🔒 關閉"
                               FontSize="13" Foreground="#2ECC71" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- UV 狀態 -->
        <Border Grid.Row="3" Background="#16213E" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="💡 UV 燈狀態" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E0E0E0" Margin="0,0,0,12" />

                <Border x:Name="UvStatusPanel" Background="#2C3E50" CornerRadius="6"
                        Padding="10,6">
                    <TextBlock x:Name="UvStatusText" Text="UV 燈：⚫ 關閉"
                               FontSize="13" Foreground="#95A5A6" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- USB 模擬控制 -->
        <Border Grid.Row="4" Background="#16213E" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="💾 USB 實體模擬 (OS 級)" FontSize="16" FontWeight="SemiBold"
                           Foreground="#E0E0E0" Margin="0,0,0,12" />

                <ComboBox x:Name="CmbUsbDisks" Height="32" FontSize="14" Margin="0,0,0,10"
                          DisplayMemberPath="DisplayName" />
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnRefreshUsb" Grid.Column="0" Content="重新整理清單"
                            Style="{StaticResource SimButton}"
                            Background="#34495E" BorderBrush="#2C3E50"
                            Padding="12,0" Margin="0,0,10,0" Height="36"
                            Click="BtnRefreshUsb_Click" />
                    <Button x:Name="BtnSimulateReplug" Grid.Column="1" Content="模擬實體拔插 (需 UAC)"
                            Style="{StaticResource SimButton}"
                            Background="#D35400" BorderBrush="#E67E22" Height="36"
                            Click="BtnSimulateReplug_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 日誌 -->
        <Border Grid.Row="5" Background="#16213E" CornerRadius="12" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="📋 通訊日誌" FontSize="16" FontWeight="SemiBold"
                               Foreground="#E0E0E0" />
                    <Button x:Name="BtnClearLog" Content="清除"
                            HorizontalAlignment="Right" FontSize="12"
                            Foreground="#7F8C8D" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Click="BtnClearLog_Click" />
                </Grid>
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         Foreground="#ABB2B9" FontSize="11" FontFamily="Consolas"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
