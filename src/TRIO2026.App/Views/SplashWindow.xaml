<Window x:Class="TRIO2026.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRIO2026"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- 旋轉動畫 Storyboard -->
        <Storyboard x:Key="SpinnerAnimation" RepeatBehavior="Forever">
            <DoubleAnimation
                Storyboard.TargetName="SpinnerRotate"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:1.2" />
        </Storyboard>

        <!-- 進度文字淡入淡出 -->
        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="StatusText"
                Storyboard.TargetProperty="Opacity"
                From="0.5" To="1.0"
                Duration="0:0:0.8" />
        </Storyboard>
    </Window.Resources>

    <!-- 全螢幕深色背景 -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                <GradientStop Color="#0F1B2D" Offset="0" />
                <GradientStop Color="#1A2744" Offset="0.5" />
                <GradientStop Color="#0D2137" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 置中內容區 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Logo 區域（未來可替換為公司 Logo 圖片） -->
            <!-- 替換方式：移除下方 TextBlock，改為：
                 <Image Source="/Assets/logo.png" Width="280" Height="auto" /> -->
            <TextBlock Text="TRIO"
                       FontSize="72"
                       FontWeight="Bold"
                       Foreground="#4FC3F7"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#4FC3F7" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="2  0  2  6"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="#78909C"
                       HorizontalAlignment="Center"
                       Margin="0,-8,0,0"
                       FontFamily="Segoe UI" />

            <!-- 分隔線 -->
            <Border Width="120" Height="1"
                    Background="#2196F3" Opacity="0.5"
                    Margin="0,24,0,24" />

            <!-- 載入旋轉動畫 -->
            <Canvas Width="40" Height="40"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" CenterX="20" CenterY="20" />
                </Canvas.RenderTransform>

                <!-- 圓弧 spinner（用 Path 繪製 3/4 圓弧） -->
                <Path Stroke="#4FC3F7" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="20,2" IsClosed="False">
                                <ArcSegment Point="2,20" Size="18,18"
                                            SweepDirection="Clockwise" IsLargeArc="False" />
                            </PathFigure>
                            <PathFigure StartPoint="2,20" IsClosed="False">
                                <ArcSegment Point="20,38" Size="18,18"
                                            SweepDirection="Clockwise" IsLargeArc="False" />
                            </PathFigure>
                            <PathFigure StartPoint="20,38" IsClosed="False">
                                <ArcSegment Point="38,20" Size="18,18"
                                            SweepDirection="Clockwise" IsLargeArc="False" />
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- 狀態文字 -->
            <TextBlock x:Name="StatusText"
                       Text="System Initializing..."
                       FontSize="14"
                       Foreground="#607D8B"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI" />
        </StackPanel>

        <!-- 底部版權資訊 -->
        <TextBlock Text="PlexBio Co., Ltd."
                   FontSize="12"
                   Foreground="#37474F"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,40"
                   FontFamily="Segoe UI" />
    </Grid>
</Window>
