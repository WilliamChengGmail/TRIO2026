<UserControl x:Class="TRIO2026.App.Views.Pages.DataDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TRIO2026.App.Controls"
             xmlns:svc="clr-namespace:TRIO2026.App.Services">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SectionHeaderBg" Color="#1A2D4C" />

        <!-- 摺疊 Section 按鈕（無 hover，觸控 56px 高） -->
        <Style x:Key="SectionHeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource SectionHeaderBg}"
                                CornerRadius="10" Padding="16,14" Margin="0,6"
                                MinHeight="56">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 返回按鈕（觸控友善 56x56） -->
        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10"
                                Padding="14,8" MinWidth="56" MinHeight="56">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A5A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下載按鈕 -->
        <Style x:Key="DownloadButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DlBd" CornerRadius="10" Padding="0,14"
                                Margin="16,8" MinHeight="56">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource PrimaryBlue}" Offset="0" />
                                    <GradientStop Color="{DynamicResource AccentTeal}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DlBd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>  <!-- 頂部列（加大） -->
            <RowDefinition Height="*"/>    <!-- 內容 -->
            <RowDefinition Height="Auto"/> <!-- 底部下載按鈕 -->
            <RowDefinition Height="40"/>   <!-- 底部狀態列 -->
        </Grid.RowDefinitions>

        <!-- ═══ 頂部列 ═══ -->
        <Border Grid.Row="0" Background="#15203A" BorderBrush="#1E3050" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- 返回 -->
                    <ColumnDefinition Width="*"/>     <!-- 標題 -->
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BackButton}"
                        Content="◀" Click="OnBackClick" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="TxtTitle"
                               Text="{Binding [Data.DetailTitle], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="TxtRunId"
                               FontSize="14" FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 內容（垂直捲動） ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="12,8,12,8" />
        </ScrollViewer>

        <!-- ═══ 底部下載按鈕 ═══ -->
        <Button x:Name="BtnDownloadSingle" Grid.Row="2"
                Style="{StaticResource DownloadButton}"
                Click="OnDownloadClick" />

        <!-- ═══ 底部狀態列 ═══ -->
        <Border Grid.Row="3" Background="#0C1524">
            <Grid Margin="16,0">
                <TextBlock x:Name="TxtStatus"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="#546E7A" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock x:Name="CountdownText"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{DynamicResource AccentTealBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
