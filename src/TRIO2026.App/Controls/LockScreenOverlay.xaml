<UserControl x:Class="TRIO2026.App.Controls.LockScreenOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TRIO2026.App.Controls"
             Visibility="Collapsed">

    <UserControl.Resources>

        <Storyboard x:Key="ShakeAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <EasingDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="10" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="-4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#CC0F1B2D">
        <!-- 鎖定卡片 -->
        <Border x:Name="LockCard"
                Width="420"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="24" Padding="40,32"
                Margin="0,0,0,80">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CardBackgroundAlt}" Opacity="0.95" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="50" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>

            <StackPanel>
                <!-- 鎖定圖示 -->
                <TextBlock Text="🔒" FontSize="48"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- 標題 -->
                <TextBlock x:Name="TitleText" Text="Screen Locked"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- 使用者資訊 -->
                <TextBlock x:Name="UserInfoText" Text=""
                           FontSize="15" Foreground="#90CAF9"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />

                <!-- 鎖定時間 -->
                <TextBlock x:Name="LockedAtText" Text=""
                           FontSize="12" Foreground="#6688AA"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- 密碼標籤 -->
                <TextBlock x:Name="LblPassword" Text="Password"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,0,0,6" />

                <!-- 密碼輸入框 -->
                <Border Background="#354B70" CornerRadius="12"
                        BorderBrush="#4A6A9A" BorderThickness="1.5"
                        Height="56" Margin="0,0,0,8"
                        PreviewMouseLeftButtonDown="PasswordBorder_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox" Grid.Column="0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="#80D8FF"
                                     SelectionBrush="#5542A5F5"
                                     FontSize="20" FontFamily="Segoe UI"
                                     VerticalContentAlignment="Center"
                                     Margin="16,0,0,0" Padding="4,0"
                                     KeyDown="PasswordBox_KeyDown" />
                        <Button x:Name="KeyboardButton" Grid.Column="1"
                                Content="⌨" FontSize="22"
                                Width="48" Height="48"
                                Foreground="#90CAF9" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                Margin="0,0,4,0"
                                Click="KeyboardButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 錯誤訊息 -->
                <TextBlock x:Name="ErrorText"
                           FontSize="13" Foreground="{DynamicResource ErrorRedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           Visibility="Collapsed" />

                <!-- 按鈕列 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 解鎖按鈕 -->
                    <Button x:Name="UnlockButton" Grid.Column="0"
                            Height="48" FontSize="18" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand"
                            Click="UnlockButton_Click" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Padding="0,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{StaticResource PrimaryBlue}" Offset="0" />
                                            <GradientStop Color="{StaticResource AccentTeal}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 切換使用者按鈕 -->
                    <Button x:Name="SwitchUserButton" Grid.Column="1"
                            Width="130" Height="48" FontSize="14"
                            Foreground="#90CAF9" Cursor="Hand"
                            Click="SwitchUserButton_Click"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12" Padding="8,10"
                                        Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="#4A6A9A" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- 進行中工作狀態 -->
                <Border x:Name="WorkStatusPanel"
                        Background="#1A3A5C" CornerRadius="8"
                        Padding="12,8" Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="WorkStatusText"
                               FontSize="14" Foreground="#80D8FF"
                               HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 穿透訊息區域（高優先級，獨立於鎖定卡片之外） -->
        <Border x:Name="PassthroughPanel"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Width="420" Margin="0,0,0,40"
                CornerRadius="16" Padding="20,16"
                Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource ErrorRed}" Opacity="0.9" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ErrorRed}" BlurRadius="20" ShadowDepth="0" Opacity="0.4" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="PassthroughTitle"
                           FontSize="18" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock x:Name="PassthroughMessage"
                           FontSize="14" Foreground="#FFCDD2"
                           HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Admin 登出確認面板 -->
        <Border x:Name="AdminConfirmPanel"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="440" CornerRadius="20" Padding="32,28"
                Visibility="Collapsed">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource CardBackgroundAlt}" Opacity="0.98" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <!-- 警告圖示 -->
                <TextBlock Text="⚠️" FontSize="42"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />

                <!-- 標題 -->
                <TextBlock x:Name="ConfirmTitle" Text=""
                           FontSize="20" FontWeight="Bold" Foreground="#FFB74D"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                <!-- 警告訊息 -->
                <TextBlock x:Name="ConfirmMessage" Text=""
                           FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,0,0,24" />

                <!-- 按鈕列 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 取消 -->
                    <Button x:Name="ConfirmCancelBtn" Grid.Column="0"
                            Height="48" FontSize="16" Foreground="#90CAF9" Cursor="Hand"
                            Click="ConfirmCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12" Padding="0,10"
                                        Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="#4A6A9A" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 確認登出 -->
                    <Button x:Name="ConfirmLogoutBtn" Grid.Column="2"
                            Height="48" FontSize="16" FontWeight="SemiBold"
                            Foreground="White" Cursor="Hand"
                            Click="ConfirmLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="12" Padding="0,10"
                                        Background="{DynamicResource ErrorRedBrush}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ 鍵盤層 ═══ -->
        <controls:NumericKeypadOverlay x:Name="NumericKeypad" />
        <controls:TouchKeyboardOverlay x:Name="TouchKeyboard" />
    </Grid>
</UserControl>
