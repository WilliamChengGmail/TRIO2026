<UserControl x:Class="TRIO2026.App.Views.Pages.DataListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TRIO2026.App.Controls"
             xmlns:svc="clr-namespace:TRIO2026.App.Services">

    <UserControl.Resources>
        <Color x:Key="PrimaryBlue">#42A5F5</Color>
        <Color x:Key="AccentTeal">#26C6DA</Color>
        <Color x:Key="TextPrimary">#F0F4F8</Color>
        <Color x:Key="TextSecondary">#B0BEC5</Color>
        <Color x:Key="CardBg">#1E2D4A</Color>
        <Color x:Key="CardBorder">#2A3D5E</Color>
        <Color x:Key="ErrorRed">#EF5350</Color>
        <Color x:Key="WarningAmber">#FFA726</Color>
        <Color x:Key="SuccessGreen">#66BB6A</Color>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />

        <!-- 無 hover 按鈕：僅 IsPressed -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4570" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card item 按鈕（無 hover） -->
        <Style x:Key="CardItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBd" Background="#1E2D4A" CornerRadius="12"
                                BorderBrush="#2A3D5E" BorderThickness="1"
                                Padding="16,12" Margin="0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBd" Property="Background" Value="#2A4570" />
                                <Setter TargetName="CardBd" Property="BorderBrush" Value="#64B5F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact item 按鈕 -->
        <Style x:Key="CompactItemButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CompBd" Background="#1E2D4A"
                                BorderBrush="#1A2742" BorderThickness="0,0,0,1"
                                Padding="12,14">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CompBd" Property="Background" Value="#2A4570" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部下載按鈕 -->
        <Style x:Key="DownloadButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DlBd" CornerRadius="12" Padding="0,14"
                                Margin="16,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource PrimaryBlue}" Offset="0" />
                                    <GradientStop Color="{StaticResource AccentTeal}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DlBd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DlBd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 選取模式的 CheckBox（觸控友善 48x48） -->
        <Style x:Key="SelectCheckBox" TargetType="CheckBox">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,12,0" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 篩選面板 — 快速日期 Chip 按鈕 -->
        <Style x:Key="FilterChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="#1E2D4A" />
            <Setter Property="BorderBrush" Value="#2A3D5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="#2A4570" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 篩選面板 — Type Toggle 按鈕 -->
        <Style x:Key="FilterTypeButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="#1E2D4A" />
            <Setter Property="BorderBrush" Value="#2A3D5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="70" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TypeBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TypeBd" Property="Background" Value="#2A4570" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 篩選面板 — 底部大按鈕（套用/重設） -->
        <Style x:Key="FilterActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="64" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActBd" Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActBd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 篩選面板 — Operator CheckBox -->
        <Style x:Key="FilterOperatorCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 篩選面板 — 觸控放大 DatePicker：完整 ControlTemplate，日曆圖示 2x，深色文字 -->
        <Style x:Key="TouchDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="#1A2040" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#42A5F5" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <!-- 日期文字輸入框 -->
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="#1A2040"
                                                   Background="Transparent"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalContentAlignment="Center"
                                                   Padding="12,0"
                                                   BorderThickness="0" />
                                <!-- 日曆圖示按鈕 (2x 大小) -->
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="&#x1F4C5;" FontSize="34"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </Button>
                                <!-- 日曆彈出 (DatePicker 自動管理內容) -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePickerTextBox 深色文字（隱式套用）-->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#1A2040" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>  <!-- 頂部列 -->
            <RowDefinition Height="Auto"/> <!-- 篩選列 (Admin) -->
            <RowDefinition Height="*"/>    <!-- 清單內容 -->
            <RowDefinition Height="Auto"/> <!-- 底部下載列 (多選模式) -->
            <RowDefinition Height="40"/>   <!-- 底部狀態列 -->
        </Grid.RowDefinitions>

        <!-- ═══ 頂部列 ═══ -->
        <Border Grid.Row="0" Background="#15203A" BorderBrush="#1E3050" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,200,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- 標題 -->
                    <ColumnDefinition Width="Auto"/> <!-- 版面切換 -->
                    <ColumnDefinition Width="Auto"/> <!-- 選取按鈕 -->
                    <ColumnDefinition Width="Auto"/> <!-- 篩選按鈕 -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding [Data.PageTitle], Source={x:Static svc:LocalizationService.Instance}}"
                           FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- 版面切換 -->
                <Button x:Name="BtnLayoutSwitch" Grid.Column="1"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnLayoutSwitchClick"
                        Content="▦" FontSize="24" />

                <!-- 選取按鈕 -->
                <Button x:Name="BtnSelect" Grid.Column="2"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnSelectClick" />

                <!-- 篩選按鈕 -->
                <Button x:Name="BtnFilter" Grid.Column="3"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnFilterClick"
                        Content="🔍" FontSize="22" />
            </Grid>
        </Border>

        <!-- ═══ 篩選列（Admin 專屬的快速切換 + 進階篩選指示）═══ -->
        <Border x:Name="AdminFilterBar" Grid.Row="1"
                Background="#15203A" Padding="12,6"
                BorderBrush="#1E3050" BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Label -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Toggle -->
                    <ColumnDefinition Width="*"/>   <!-- spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- 進階篩選指示 -->
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtScopeLabel" Grid.Column="0"
                           FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,6,0" />
                <Button x:Name="BtnScopeToggle" Grid.Column="1"
                        Style="{StaticResource ToolbarButton}"
                        Click="OnScopeToggle" FontSize="16" />
                <!-- 進階篩選指示燈（有日期或 Type 篩選時顯示）-->
                <StackPanel x:Name="AdvancedFilterIndicator" Grid.Column="3"
                            Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Stretch" Margin="0,2,0,2">
                    <Border Background="#FFA726" CornerRadius="8"
                            Padding="14,0" VerticalAlignment="Stretch">
                        <TextBlock x:Name="TxtAdvancedFilterLabel"
                                   FontSize="18" FontWeight="Bold" Foreground="#121212"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="BtnClearAdvancedFilter" Content="✕"
                            Foreground="#EF5350" FontSize="26" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            MinWidth="52" MinHeight="44"
                            VerticalAlignment="Stretch"
                            Padding="10,0"
                            Click="OnClearAdvancedFilterClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 清單內容 ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListContainer" Margin="12,8,12,8" />
        </ScrollViewer>

        <!-- ═══ 空狀態 ═══ -->
        <StackPanel x:Name="EmptyState" Grid.Row="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="📊" FontSize="72" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="{Binding [Data.NoRecords], Source={x:Static svc:LocalizationService.Instance}}"
                       FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ═══ 底部下載列（多選模式） ═══ -->
        <Border x:Name="DownloadBar" Grid.Row="3"
                Background="#15203A" BorderBrush="#1E3050" BorderThickness="0,1,0,0"
                Visibility="Collapsed">
            <Button x:Name="BtnDownload" Style="{StaticResource DownloadButton}"
                    Click="OnDownloadClick" />
        </Border>

        <!-- ═══ 底部狀態列 ═══ -->
        <Border Grid.Row="4" Background="#0C1524">
            <Grid Margin="16,0">
                <TextBlock x:Name="TxtRecordCount"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="#37474F" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock x:Name="CountdownText"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="#26C6DA" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           Text="{Binding [Common.Ready], Source={x:Static svc:LocalizationService.Instance}}"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="#4CAF50" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ═══ Operator 篩選彈出視窗 (頂部 Quick Bar) ═══ -->
        <Popup x:Name="OperatorFilterPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnScopeToggle}" Placement="Bottom" AllowsTransparency="True">
            <Border Background="#1E2D4A" BorderBrush="#2A3D5E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,8">
                <StackPanel Width="260">
                    <Button Content="{Binding [Data.FilterMy], Source={x:Static svc:LocalizationService.Instance}}" 
                            Style="{StaticResource ToolbarButton}" 
                            Click="OnFilterMyRecordsClick" 
                            HorizontalContentAlignment="Left" />
                    <Button Content="{Binding [Data.FilterAll], Source={x:Static svc:LocalizationService.Instance}}" 
                            Style="{StaticResource ToolbarButton}" 
                            Click="OnFilterAllRecordsClick" 
                            HorizontalContentAlignment="Left" />
                    <Border Height="1" Background="#2A3D5E" Margin="0,8"/>
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="OperatorFilterItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Username}" 
                                              IsChecked="{Binding IsSelected}" 
                                              Foreground="{StaticResource TextPrimaryBrush}" 
                                              Margin="8,8" FontSize="18"
                                              Click="OnOperatorCheckboxClick">
                                        <CheckBox.LayoutTransform>
                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                        </CheckBox.LayoutTransform>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ═══ 進階篩選面板：半透明遮罩 ═══ -->
        <Border x:Name="FilterOverlayMask" Grid.RowSpan="5"
                Background="#AA000000"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnFilterOverlayMaskClick" />

        <!-- ═══ 進階篩選面板：Bottom Sheet ═══ -->
        <Border x:Name="FilterSheetPanel" Grid.RowSpan="5"
                Background="#13203A"
                BorderBrush="#2A3D5E" BorderThickness="0,1,0,0"
                CornerRadius="20,20,0,0"
                VerticalAlignment="Bottom"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterSheetTransform" Y="600" />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="640">
                <StackPanel Margin="20,16,20,24">

                    <!-- 標題列 -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding [Data.FilterTitle], Source={x:Static svc:LocalizationService.Instance}}"
                                   FontSize="24" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Content="✕" HorizontalAlignment="Right"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="30" FontWeight="Bold" Cursor="Hand"
                                MinWidth="56" MinHeight="56" Padding="8"
                                Click="OnFilterClose" />
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="#1E3050" Margin="0,0,0,20" />

                    <!-- ── 日期範圍 ── -->
                    <TextBlock Text="{Binding [Data.FilterDateRange], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="20" FontWeight="SemiBold" Foreground="#64B5F6"
                               Margin="0,0,0,14" />

                    <!-- 快速日期 Chip -->
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Button x:Name="BtnChipToday" Margin="3"
                                Style="{StaticResource FilterChipButton}"
                                Content="{Binding [Data.FilterDateToday], Source={x:Static svc:LocalizationService.Instance}}"
                                Click="OnChipToday" />
                        <Button x:Name="BtnChip7D" Margin="3"
                                Style="{StaticResource FilterChipButton}"
                                Content="{Binding [Data.FilterDate7D], Source={x:Static svc:LocalizationService.Instance}}"
                                Click="OnChip7D" />
                        <Button x:Name="BtnChip30D" Margin="3"
                                Style="{StaticResource FilterChipButton}"
                                Content="{Binding [Data.FilterDate30D], Source={x:Static svc:LocalizationService.Instance}}"
                                Click="OnChip30D" />
                        <Button x:Name="BtnChip3M" Margin="3"
                                Style="{StaticResource FilterChipButton}"
                                Content="{Binding [Data.FilterDate3M], Source={x:Static svc:LocalizationService.Instance}}"
                                Click="OnChip3M" />
                    </UniformGrid>

                    <!-- 自訂日期：開始 -->
                    <TextBlock Text="{Binding [Data.FilterDateFrom], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,6" />
                    <DatePicker x:Name="DpFilterFrom"
                                Style="{StaticResource TouchDatePickerStyle}"
                                Margin="0,0,0,16"
                                SelectedDateChanged="OnFilterDateChanged">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="2.0" ScaleY="2.0"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>

                    <!-- 自訂日期：結束 -->
                    <TextBlock Text="{Binding [Data.FilterDateTo], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,6" />
                    <DatePicker x:Name="DpFilterTo"
                                Style="{StaticResource TouchDatePickerStyle}"
                                Margin="0,0,0,24"
                                SelectedDateChanged="OnFilterDateChanged">
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar">
                                <Setter Property="LayoutTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="2.0" ScaleY="2.0"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="#1E3050" Margin="0,0,0,20" />

                    <!-- ── 資料類型 ── -->
                    <TextBlock Text="{Binding [Data.FilterType], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="20" FontWeight="SemiBold" Foreground="#64B5F6"
                               Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnTypeIPlex" Grid.Column="0"
                                Style="{StaticResource FilterTypeButton}"
                                Content="IntelliPlex"
                                Click="OnTypeIPlexClick" />
                        <Button x:Name="BtnTypeQPlex" Grid.Column="2"
                                Style="{StaticResource FilterTypeButton}"
                                Content="Custom"
                                Click="OnTypeQPlexClick" />
                    </Grid>

                    <!-- ── 操作員（Admin Only）── -->
                    <Border x:Name="OperatorFilterSection" Visibility="Collapsed">
                        <StackPanel>
                            <Border Height="1" Background="#1E3050" Margin="0,0,0,20" />
                            <TextBlock Text="{Binding [Data.FilterByUser], Source={x:Static svc:LocalizationService.Instance}}"
                                       FontSize="24" FontWeight="SemiBold" Foreground="#64B5F6"
                                       Margin="0,0,0,14" />
                            <Border Background="#1A2840" CornerRadius="10"
                                    BorderBrush="#2A3D5E" BorderThickness="1">
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="FilterPanelOperatorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Username}"
                                                          IsChecked="{Binding IsSelected}"
                                                          Style="{StaticResource FilterOperatorCheckBox}"
                                                          Padding="12,0"
                                                          Click="OnFilterPanelOperatorClick" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 間距 -->
                    <Border Height="24" />

                    <!-- ── 底部按鈕 ── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FilterActionButton}"
                                Background="#1E2D4A"
                                Content="{Binding [Data.FilterReset], Source={x:Static svc:LocalizationService.Instance}}"
                                Click="OnFilterReset" />
                        <Button Grid.Column="2" Style="{StaticResource FilterActionButton}"
                                Click="OnFilterApply">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#42A5F5" Offset="0" />
                                    <GradientStop Color="#26C6DA" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Content>
                                <TextBlock Text="{Binding [Data.FilterApply], Source={x:Static svc:LocalizationService.Instance}}"
                                           FontSize="22" FontWeight="Bold" />
                            </Button.Content>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 共用使用者選單 ═══ -->
        <controls:UserMenuControl x:Name="UserMenu" Grid.RowSpan="5"
                                  ShowHomeButton="True"/>
    </Grid>
</UserControl>
