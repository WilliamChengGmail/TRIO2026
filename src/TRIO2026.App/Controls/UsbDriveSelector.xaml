<UserControl x:Class="TRIO2026.App.Controls.UsbDriveSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:TRIO2026.App.Services">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4F8" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0BEC5" />

        <!-- USB 碟卡片按鈕（無 hover） -->
        <Style x:Key="UsbCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1E2D4A" CornerRadius="12"
                                BorderBrush="#2A3D5E" BorderThickness="1"
                                Padding="16,14" Margin="0,4"
                                MinHeight="48">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4570" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#64B5F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按鈕 -->
        <Style x:Key="CancelButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#B0BEC5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1A2742" CornerRadius="10"
                                Padding="0,12" Margin="16,4,16,12" MinHeight="48">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A4570" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 全螢幕半透明背景 -->
    <Grid Background="#CC000000" Visibility="Collapsed" x:Name="RootOverlay">
        <!-- 居中面板 -->
        <Border Background="#15203A" CornerRadius="16"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="480" MaxHeight="700"
                BorderBrush="#2A3D5E" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 標題 -->
                    <RowDefinition Height="*"/>     <!-- 碟片列表 -->
                    <RowDefinition Height="Auto"/>  <!-- 等待提示 / 取消 -->
                </Grid.RowDefinitions>

                <!-- 標題 -->
                <TextBlock Grid.Row="0" x:Name="TxtTitle"
                           Text="{Binding [Data.UsbSelect], Source={x:Static svc:LocalizationService.Instance}}"
                           FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,8" />

                <!-- 碟片列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Margin="16,0">
                    <StackPanel x:Name="DriveList" />
                </ScrollViewer>

                <!-- 等待提示（無碟時） -->
                <StackPanel x:Name="WaitingPanel" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💾" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding [Data.UsbNone], Source={x:Static svc:LocalizationService.Instance}}"
                               FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="24,0" />
                </StackPanel>

                <!-- 取消按鈕 -->
                <Button Grid.Row="2" Style="{StaticResource CancelButton}"
                        Content="{Binding [Common.Cancel], Source={x:Static svc:LocalizationService.Instance}}"
                        Click="OnCancelClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
