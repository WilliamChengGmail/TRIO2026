<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基礎色票 (Colors) -->
    <!-- 背景類 -->
    <Color x:Key="AppBackground">#0A1628</Color>
    <Color x:Key="PanelBackground">#0D1B30</Color>
    <Color x:Key="CardBackground">#1E2D4A</Color>
    <Color x:Key="CardBackgroundAlt">#2A3A5C</Color>
    <Color x:Key="OverlayBackground">#1E2D45</Color>

    <!-- 文字類 -->
    <Color x:Key="TextPrimary">#F0F4F8</Color>
    <Color x:Key="TextSecondary">#B0BEC5</Color>
    <Color x:Key="TextMuted">#7B8FA8</Color>
    <Color x:Key="TextInverse">#0A1628</Color>

    <!-- 主色與輔助色 -->
    <Color x:Key="PrimaryBlue">#42A5F5</Color>
    <Color x:Key="PrimaryBlueHover">#64B5F6</Color>
    <Color x:Key="AccentTeal">#26C6DA</Color>
    
    <!-- 狀態色 -->
    <Color x:Key="ErrorRed">#EF5350</Color>
    <Color x:Key="StopRed">#E53935</Color>
    <Color x:Key="SuccessGreen">#4CAF50</Color>
    <Color x:Key="WarningYellow">#FFCA28</Color>

    <!-- 邊框與分隔線 -->
    <Color x:Key="BorderLight">#3A5070</Color>
    <Color x:Key="BorderDark">#1A2F4D</Color>

    <!-- UI 狀態回饋 (按鈕等) -->
    <Color x:Key="ControlHover">#2A4570</Color>
    <Color x:Key="ControlPressed">#1E3A5F</Color>
    
    <!-- 漸層/特效專用 -->
    <Color x:Key="SplashGradient1">#0F1B2D</Color>
    <Color x:Key="SplashGradient2">#1A2744</Color>
    <Color x:Key="SplashGradient3">#0D2137</Color>
    <Color x:Key="UvGradientStart">#B388FF</Color>
    <Color x:Key="UvGradientEnd">#7C4DFF</Color>


    <!-- 筆刷 (Brushes) 對應上述 Color -->
    <!-- 背景類筆刷 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="CardBackgroundAltBrush" Color="{StaticResource CardBackgroundAlt}" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="{StaticResource OverlayBackground}" />

    <!-- 文字類筆刷 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverse}" />

    <!-- 狀態與主色筆刷 -->
    <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}" />
    <SolidColorBrush x:Key="PrimaryBlueHoverBrush" Color="{StaticResource PrimaryBlueHover}" />
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTeal}" />
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}" />
    <SolidColorBrush x:Key="StopRedBrush" Color="{StaticResource StopRed}" />
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}" />
    
    <!-- 邊框與控制項筆刷 -->
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDark}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHover}" />
    
    <!-- 原本某些元件直接使用的特定名稱為了相容可以保留 -->
    <Color x:Key="CardBg">#2A3A5C</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBg}" />

    <!-- Splash 專用色彩與筆刷 (深色系) -->
    <Color x:Key="SplashLogoColor">#4FC3F7</Color>
    <SolidColorBrush x:Key="SplashLogoBrush" Color="{StaticResource SplashLogoColor}" />
    <SolidColorBrush x:Key="SplashTextBrush" Color="#78909C" />
    <SolidColorBrush x:Key="SplashLineBrush" Color="#2196F3" />
    <SolidColorBrush x:Key="SplashSpinnerBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="SplashStatusBrush" Color="#607D8B" />
    <SolidColorBrush x:Key="SplashCopyrightBrush" Color="#37474F" />
</ResourceDictionary>
